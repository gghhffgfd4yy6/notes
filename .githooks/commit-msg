#!/bin/bash
# commit-msg 钩子：提交信息规范校验（可 git commit --no-verify 跳过）
# 允许前缀：fix: feat: refactor: docs: chore: style: test: perf: revert: build: ci:
msg_file="$1"
msg=$(head -1 "$msg_file")
if ! echo "$msg" | grep -qE '^(fix|feat|refactor|docs|chore|style|test|perf|revert|build|ci)(\(.*\))?:'; then
  echo "❌ 提交信息必须以类型前缀开头: fix: / feat: / refactor: / docs: / chore: / style: / test: / perf: / revert: / build: / ci:"
  echo "   实际: $msg"
  exit 1
fi
len=${#msg}
if [ "$len" -gt 100 ]; then
  echo "❌ 提交信息首行过长（${len} 字符 > 100），请精简"
  exit 1
fi
# 标题必须是**独立一段**（v3.282）：git 会把「标题后没空行」的多行首段整体当作 subject——
# 于是上面那条「首行 ≤100 字符」在落地时已经变成一整段，`git log --oneline` 也跟着吐一坨。
# 本仓 v3.281 那个提交就是这么写的（标题被并成 5 行），钩子当时完全没拦。
# 注释行（`#` 开头）不算违规：git 在调用本钩子前会按 cleanup 规则剔除它们。
second=$(sed -n '2p' "$msg_file")
case "$second" in
  ''|'#'*) ;;
  *)
    echo "❌ 标题与正文之间必须留一个空行（当前第 2 行是：${second}）"
    echo "   没有空行时 git 会把整段当标题：首行长度限制失效、git log --oneline 会打印整段正文"
    exit 1
    ;;
esac
exit 0
