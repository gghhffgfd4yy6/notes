#!/bin/bash
# commit-msg 钩子：提交信息规范校验（可 git commit --no-verify 跳过）
# 允许前缀：fix: feat: refactor: docs: chore: style: test: perf: revert: build: ci:
msg_file="$1"
msg=$(head -1 "$msg_file")
if ! echo "$msg" | grep -qE '^(fix|feat|refactor|docs|chore|style|test|perf|revert|build|ci)(\(.*\))?:'; then
  echo "❌ 提交信息必须以类型前缀开头: fix: / feat: / refactor: / docs: / chore: / style: / test: / perf: / revert: / build: / ci:"
  echo "   实际: $msg"
  exit 1
fi
len=${#msg}
if [ "$len" -gt 100 ]; then
  echo "❌ 提交信息首行过长（${len} 字符 > 100），请精简"
  exit 1
fi
# 标题必须是**独立一段**（v3.282）：git 会把「标题后没空行」的多行首段整体当作 subject——
# 于是上面那条「首行 ≤100 字符」在落地时已经变成一整段，`git log --oneline` 也跟着吐一坨。
# 本仓 v3.281 那个提交就是这么写的（标题被并成 5 行），钩子当时完全没拦。
# 注释行**是否**能跳过取决于 Git 的有效 cleanup 模式（review #211）：commit.cleanup=whitespace / verbatim /
# scissors 会保留 # 行，strip 才会剔除；未显式配置时，GIT_EDITOR=: 是 -m/-F 的 whitespace 口径，编辑器模式按 strip。
# 这里先按 Git 的有效口径取标题后的第一行：保留 # 行的模式下它不能伪装成分隔空行，剔除 # 行的模式才跳过注释。
cleanup_mode=$(git config --get commit.cleanup 2>/dev/null || printf '%s' default)
if [ "$cleanup_mode" = 'default' ]; then
  if [ "${GIT_EDITOR:-}" = ':' ]; then
    cleanup_mode='whitespace'
  else
    cleanup_mode='strip'
  fi
fi
case "$cleanup_mode" in
  whitespace|verbatim|scissors)
    first_after_title=$(sed -n '2p' "$msg_file")
    ;;
  *)
    first_after_title=$(sed -n '2,$p' "$msg_file" | grep -v '^#' | sed -n '1p')
    ;;
esac
case "$(printf '%s' "$first_after_title" | tr -d '[:space:]')" in
  '') ;;
  *)
    echo "❌ 标题与正文之间必须留一个空行（标题后第一个非注释行是：${first_after_title}）"
    echo "   没有空行时 git 会把整段当标题：首行长度限制失效、git log --oneline 会打印整段正文"
    echo "   注意：保留 # 行的 cleanup 模式下，# 行不算空行；剔除模式下才会跳过它"
    exit 1
    ;;
esac
exit 0
