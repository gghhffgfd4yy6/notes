{
  "name": "xbk-push",
  "version": "3.272.0",
  "description": "线报酷推送脚本——规则过滤 + 多通道推送 + 去重缓存 + 运行日志 + 完整测试体系",
  "main": "xbk_function_v3.js",
  "scripts": {
    "start": "node xbk_function_v3.js",
    "start:loop": "node qinglong/xbk_push.js",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "node run_tests.js",
    "test:unit": "node run_unit_tests.js",
    "test:filter": "node test_filter.js",
    "test:mutation-json": "node test_mutation_json.js",
    "test:mutation-report": "node test_mutation_report.js",
    "test:app": "node test_app_p.js",
    "test:app:serial": "node test_app.js",
    "test:notify": "node test_notify.js",
    "test:lazy": "node test_lazy_notify.js",
    "test:loop": "node test_loop.js",
    "test:failure-policy": "node test_failure_policy.js",
    "test:dns": "node test_dns_cache.js",
    "test:tls-prewarm": "node test_tls_prewarm.js",
    "test:loop-utils": "node test_loop_utils.js",
    "test:storage": "node test_storage.js",
    "test:agents": "node test_agents.js",
    "test:network": "node test_network.js",
    "test:http": "node test_http.js",
    "test:sendnotify-utils": "node test_sendnotify_utils.js",
    "test:qinglong-utils": "node test_qinglong_utils.js",
    "test:cli": "node test_cli.js",
    "test:qinglong-resident": "node test_qinglong_resident.js",
    "test:qinglong-runcheck": "node test_qinglong_runcheck.js",
    "test:status": "node test_status.js",
    "test:check-mutation-ranges": "node test_check_mutation_ranges.js",
    "test:mutation-ranges-unit": "node test_mutation_ranges.js",
    "test:mutation": "stryker run",
    "test:mutation-ranges": "node scripts/check-mutation-ranges.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary --exclude='test_*.js' --exclude='run_tests.js' node run_tests.js",
    "check": "npm run lint && node check-version.js && node scripts/check-mutation-ranges.js && npm test",
    "verify": "npm run check"
  },
  "dependencies": {
    "got": "11.8.6"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "keywords": [
    "推送",
    "线报",
    "push",
    "server酱",
    "bark",
    "telegram",
    "pushplus"
  ],
  "license": "UNLICENSED",
  "private": true,
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "c8": "^12.0.0",
    "fast-check": "^4.9.0",
    "standard": "^17.1.2"
  },
  "allowScripts": {
    "re2@1.26.1": true
  },
  "optionalDependencies": {
    "re2": "^1.26.1"
  }
}
